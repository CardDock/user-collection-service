generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CardCondition {
  MINT
  NEAR_MINT
  LIGHTLY_PLAYED
  PLAYED
  DAMAGED
}

enum CardRarity {
  COMMON
  RARE
  SUPER_RARE
  ULTRA_RARE
  SECRET_RARE
  ULTIMATE_RARE
  GHOST_RARE
  PRISMATIC_SECRET_RARE
  STARLIGHT_RARE
  COLLECTORS_RARE
}



model UserCollection {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  cardId        Int           @map("card_id")
  setId         String        @default("UNKNOWN") @map("set_id")
  condition     CardCondition
  rarity        CardRarity
  quantity      Int           @default(1)
  language      String        @default("en")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@index([cardId])
  @@index([setId])
  @@map("user_collections")
}
